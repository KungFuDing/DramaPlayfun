// Optional local values used only by Debug builds.
DEBUG_ACCESS_TOKEN =
DEBUG_LANGUAGE =
HLS_SHARED_SECRET =
#include? "Debug.local.xcconfig"

// StoreKit Testing requires the simulator app to be marked as a development build.
// This entitlement is never applied to device or Release builds.
CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*] = Config/SimulatorDebug.entitlements
