<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>保存短剧分享图片到相册，便于分享给朋友。</string>
    <key>APIBaseURL</key>
    <string>$(API_BASE_URL)</string>
    <key>HLSSharedSecret</key>
    <string>$(HLS_SHARED_SECRET)</string>
    <key>NSAppTransportSecurity</key>
    <dict><key>NSAllowsLocalNetworking</key><true/></dict>
    <key>DebugHTTPHeaders</key>
    <dict>
        <key>accessToken</key><string>$(DEBUG_ACCESS_TOKEN)</string>
        <key>countryCode</key><string>$(DEBUG_COUNTRY_CODE)</string>
        <key>deviceId</key><string>$(DEBUG_DEVICE_ID)</string>
        <key>ip</key><string>$(DEBUG_IP)</string>
        <key>language</key><string>$(DEBUG_LANGUAGE)</string>
    </dict>
</dict>
</plist>
